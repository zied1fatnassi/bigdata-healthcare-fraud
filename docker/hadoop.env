# ---------------------------------------------------------------------------
# Shared environment for every Hadoop container.
# This is the exact variable naming convention used by the
# big-data-europe images: CORE_CONF_*, HDFS_CONF_*, YARN_CONF_*, MAPRED_CONF_*
# Each variable is written into the matching XML file at container start, so
# you never edit core-site.xml by hand.
# ---------------------------------------------------------------------------

CLUSTER_NAME=healthfraud

# The NameNode is reachable inside the Docker network at namenode:9000
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec

# 128 MB blocks, 2 replicas -> visible fault tolerance without eating disk
HDFS_CONF_dfs_blocksize=134217728
HDFS_CONF_dfs_replication=2
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
HDFS_CONF_dfs_client_use_datanode_hostname=true
HDFS_CONF_dfs_datanode_use_datanode_hostname=true

# YARN (ResourceManager + NodeManager) so Hive can run MapReduce jobs
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
YARN_CONF_yarn_log___aggregation___enable=true
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.FileSystemRMStateStore
YARN_CONF_yarn_resourcemanager_scheduler_class=org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler
YARN_CONF_yarn_nodemanager_local_dirs=/tmp/yarn/nm
YARN_CONF_yarn_nodemanager_resource_memory___mb=6144
YARN_CONF_yarn_nodemanager_vmem___check___enabled=false
YARN_CONF_yarn_nodemanager_disk___health___checker_max___disk___utilization___per___disk___percentage=99
YARN_CONF_yarn_timeline___service_enabled=true
YARN_CONF_yarn_timeline___service_leveldb___store=leveldb

MAPRED_CONF_mapreduce_framework_name=yarn
MAPRED_CONF_mapred_child_java_opts=-Xmx2048m
MAPRED_CONF_mapreduce_map_memory_mb=2048
MAPRED_CONF_mapreduce_reduce_memory_mb=2048
MAPRED_CONF_mapreduce_job_am_java_opts=-Xmx1024m

# Multi-host friendliness (kept for the Dual-VM variant of the project)
MULTIHOST_CONF_dfs_namenode_rpc___bind___host=0.0.0.0
MULTIHOST_CONF_dfs_datanode_address=0.0.0.0:9866
MULTIHOST_CONF_dfs_datanode_http___address=0.0.0.0:9864
MULTIHOST_CONF_dfs_datanode_ipc___address=0.0.0.0:9867
